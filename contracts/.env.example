# Hardhat configuration variables for the Sepolia deployment.
# Export these variables in the shell or provide them through the deployment platform.
HARDHAT_VAR_SEPOLIA_RPC_URL=https://sepolia.example.invalid/v1/project-id
HARDHAT_VAR_SEPOLIA_PRIVATE_KEY=replace-with-a-funded-testnet-private-key

# Address used by the backend to submit commitments after deployment.
# This can be different from the one-time deployment account.
NAESAN_ANCHOR_WRITER_ADDRESS=0x0000000000000000000000000000000000000001
